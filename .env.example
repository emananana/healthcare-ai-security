# Example only: this app does NOT automatically read .env files.
# Set these in the backend process environment; see README.
COMETCARE_MODE=mock
GROQ_API_KEY=
ENTERPRISE_MODEL=openai/gpt-oss-20b
# Live mode connects all three agents.
RED_MODEL=qwen/qwen3.8-27b
BLUE_MODEL=openai/gpt-oss-120b
# Hosted deployment only; enter secrets directly in the hosting dashboard.
COMETCARE_HOSTED=false
TEAM_PASSWORD=

# Optional local SQLite records + audit; blank keeps in-memory defaults.
# Parent directories are created; synthetic seed is safe to repeat.
COMETCARE_DB_PATH=
